{
  "policyVersion": 2,
  "applicationControl": {
    "mode": "audit-only",
    "blockedApplications": [
      {
        "ruleId": "block-calculator",
        "signingId": "com.apple.calculator"
      }
    ]
  },
  "webUploadControl": {
    "mode": "audit-only",
    "protectedDirectoryNames": [
      "Desktop",
      "Documents",
      "Downloads"
    ]
  },
  "usbStorageControl": {
    "mode": "disabled",
    "blockExternalStorage": true,
    "encryptionMode": "audit-only",
    "containerSizePercent": 90
  },
  "nearbyTransferControl": {
    "mode": "audit-only",
    "blockAirDrop": true,
    "blockBluetoothFileTransfer": true,
    "protectedDirectoryNames": [
      "Desktop",
      "Documents",
      "Downloads"
    ]
  },
  "clipboardControl": {
    "mode": "disabled",
    "blockedApplications": []
  },
  "printerControl": {
    "mode": "audit-only",
    "blockAllPrinters": true
  },
  "networkFlowControl": {
    "mode": "audit-only",
    "defaultAction": "allow",
    "rules": [
      {
        "ruleId": "audit-suspicious-exfil",
        "domain": "transfer.sh",
        "port": 443,
        "protocol": "tcp",
        "action": "block"
      }
    ]
  }
}
