{
  "policyVersion": 2,
  "applicationControl": {
    "mode": "audit-only",
    "blockedApplications": [
      {
        "ruleId": "block-calculator",
        "signingId": "com.apple.calculator"
      }
    ]
  },
  "webUploadControl": {
    "mode": "audit-only",
    "protectedDirectoryNames": [
      "Desktop",
      "Documents",
      "Downloads"
    ]
  },
  "nearbyTransferControl": {
    "mode": "audit-only",
    "blockAirDrop": true,
    "blockBluetoothFileTransfer": true,
    "protectedDirectoryNames": [
      "Desktop",
      "Documents",
      "Downloads"
    ]
  },
  "clipboardControl": {
    "mode": "disabled",
    "blockedApplications": []
  }
}
