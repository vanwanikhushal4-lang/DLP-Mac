{
  "policyVersion": 1,
  "applicationControl": {
    "mode": "enforce",
    "blockedApplications": [
      {
        "ruleId": "block-calculator",
        "signingId": "com.apple.calculator"
      }
    ]
  },
  "webUploadControl": {
    "mode": "disabled",
    "protectedDirectoryNames": [
      "Desktop",
      "Documents",
      "Downloads",
      "Movies",
      "Music",
      "Pictures",
      "Public"
    ]
  },
  "usbStorageControl": {
    "mode": "enforce",
    "blockExternalStorage": true,
    "encryptionMode": "disabled",
    "containerSizePercent": 90
  },
  "nearbyTransferControl": {
    "mode": "disabled",
    "blockAirDrop": true,
    "blockBluetoothFileTransfer": true,
    "protectedDirectoryNames": [
      "Desktop",
      "Documents",
      "Downloads",
      "Movies",
      "Music",
      "Pictures",
      "Public"
    ]
  },
  "clipboardControl": {
    "mode": "disabled",
    "blockedApplications": []
  },
  "printerControl": {
    "mode": "disabled",
    "blockAllPrinters": true
  },
  "networkFlowControl": {
    "mode": "disabled",
    "defaultAction": "allow",
    "rules": [
      {
        "ruleId": "block-raw-pastebin",
        "domain": "pastebin.com",
        "protocol": "tcp",
        "action": "block"
      }
    ]
  }
}
