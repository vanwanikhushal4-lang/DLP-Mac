{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VeloxMacDLPPolicy",
  "type": "object",
  "required": ["policyVersion", "applicationControl"],
  "additionalProperties": false,
  "properties": {
    "policyVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing version number for the policy."
    },
    "applicationControl": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Operating mode for application control."
        },
        "blockedApplications": {
          "type": "array",
          "description": "List of application rules that should be blocked or audited.",
          "items": {
            "$ref": "#/$defs/ApplicationRule"
          }
        },
        "allowedApplications": {
          "type": "array",
          "description": "List of application rules that are explicitly allowed (override block rules).",
          "items": {
            "$ref": "#/$defs/ApplicationRule"
          }
        }
      }
    },
    "webUploadControl": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Prototype browser file-upload enforcement mode."
        },
        "protectedDirectoryNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/]+$"
          }
        }
      }
    },
    "emailAttachmentControl": {
      "type": "object",
      "required": ["mode", "mailClients"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Blocks metadata-matched classified file reads by securely identified native mail clients."
        },
        "mailClients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/ApplicationRule" }
        },
        "protectedClassifications": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "description": "OCR classifications protected for email. Empty means every active classification.",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "usbStorageControl": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"]
        },
        "blockExternalStorage": {
          "type": "boolean"
        },
        "encryptionMode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Requires writes to use a Velox AES-256 encrypted removable-media container."
        },
        "containerSizePercent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 95,
          "description": "Virtual encrypted-container capacity as a percentage of the outer volume size."
        }
      }
    },
    "nearbyTransferControl": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Blocks outbound protected-file reads by AirDrop and Bluetooth transfer services."
        },
        "blockAirDrop": {
          "type": "boolean"
        },
        "blockBluetoothFileTransfer": {
          "type": "boolean"
        },
        "protectedDirectoryNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/]+$"
          }
        }
      }
    },
    "clipboardControl": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["disabled", "block-all", "block-selected-apps"],
          "description": "Block all clipboard copies or only copies originating from selected signed applications."
        },
        "blockedApplications": {
          "type": "array",
          "description": "Source applications denied from placing data on the system clipboard in block-selected-apps mode.",
          "items": {
            "$ref": "#/$defs/ApplicationRule"
          }
        }
      }
    },
    "printerControl": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Controls physical printer queues through the local CUPS scheduler."
        },
        "blockAllPrinters": {
          "type": "boolean",
          "description": "Reject, stop, and cancel jobs on every configured physical printer queue when enforcing."
        }
      }
    },
    "ocrControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Classifies text extracted from image files and scanned PDFs on device."
        },
        "screenshotMode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Classifies screenshots after Apple's signed screenshot tool creates them."
        },
        "screenshotRemediation": {
          "type": "string",
          "enum": ["quarantine", "delete"]
        },
        "recognitionLanguages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxFileSizeMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxPDFPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "rules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/OCRClassificationRule"
          }
        }
      }
    },
    "endpointDiscoveryControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Schedules at-rest scans. Enforce mode tags classified files; audit-only reports findings without modifying files."
        },
        "scheduleIntervalMinutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 10080
        },
        "includeLocalHome": { "type": "boolean" },
        "includeMountedVolumes": { "type": "boolean" },
        "includeMountedShares": { "type": "boolean" },
        "tagClassifiedFiles": { "type": "boolean" },
        "maxFilesPerScan": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        }
      }
    },
    "cloudSyncControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["enforce", "audit-only", "disabled"] },
        "blockCloudSync": { "type": "boolean" },
        "monitoredProviders": { "type": "array", "items": { "type": "string" } }
      }
    },
    "opticalDiskImageControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["enforce", "audit-only", "disabled"] },
        "blockDiskImages": {
          "type": "boolean",
          "description": "Block or audit virtual file-backed mounts such as DMG, ISO, sparseimage and sparsebundle volumes."
        },
        "blockOpticalMedia": {
          "type": "boolean",
          "description": "Block or audit CD/DVD optical filesystem mounts such as UDF and ISO 9660."
        }
      }
    },
    "screenWatermarking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["enforce", "audit-only", "disabled"] },
        "text": { "type": "string", "minLength": 1 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "printToPDFControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Controls new PDF file output by applications in standard user content folders."
        },
        "blockSaveAsPDF": {
          "type": "boolean",
          "description": "Deny or audit new PDF creates; partial-file download staging and rename finalization remain outside this authorization path."
        }
      }
    },
    "networkFlowControl": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["enforce", "audit-only", "disabled"],
          "description": "Operating mode for outbound network socket flow inspection."
        },
        "defaultAction": {
          "type": "string",
          "enum": ["allow", "block"],
          "description": "Default action for outbound connections not matching any explicit destination rule."
        },
        "rules": {
          "type": "array",
          "description": "Destination and per-process rules for network flow control.",
          "items": {
            "$ref": "#/$defs/NetworkDestinationRule"
          }
        }
      }
    }
  },
  "$defs": {
    "OCRClassificationRule": {
      "type": "object",
      "required": ["ruleId", "name", "classification", "type"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "classification": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": {
          "type": "string",
          "enum": ["keyword", "regular-expression", "credit-card", "indian-pan", "aadhaar"]
        },
        "pattern": { "type": ["string", "null"], "maxLength": 512 },
        "keywords": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "minimumMatches": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "NetworkDestinationRule": {
      "type": "object",
      "required": ["ruleId"],
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the network destination rule."
        },
        "domain": {
          "type": ["string", "null"],
          "description": "Destination domain or subdomain pattern (e.g. api.dropbox.com, *.s3.amazonaws.com)."
        },
        "ipAddress": {
          "type": ["string", "null"],
          "description": "Destination IPv4 or IPv6 address."
        },
        "cidrRange": {
          "type": ["string", "null"],
          "description": "Destination IPv4 or IPv6 CIDR subnet (e.g. 10.0.0.0/8, 192.168.1.0/24)."
        },
        "port": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 65535,
          "description": "Single destination port number."
        },
        "portRange": {
          "type": ["string", "null"],
          "description": "Destination port range formatted as 'start-end' (e.g. 80-443)."
        },
        "protocol": {
          "type": "string",
          "enum": ["any", "tcp", "udp"],
          "description": "Transport layer protocol."
        },
        "process": {
          "$ref": "#/$defs/ApplicationRule"
        },
        "action": {
          "type": "string",
          "enum": ["allow", "block"],
          "description": "Decision action for matching flows ('allow' or 'block')."
        }
      }
    },
    "ApplicationRule": {
      "type": "object",
      "required": ["ruleId"],
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the rule."
        },
        "signingId": {
          "type": ["string", "null"],
          "description": "Code signing identifier (e.g., com.apple.calculator)."
        },
        "teamId": {
          "type": ["string", "null"],
          "description": "Apple Developer Team Identifier."
        },
        "isPlatformBinary": {
          "type": ["boolean", "null"],
          "description": "Whether the application is an Apple platform binary."
        },
        "cdhash": {
          "type": ["string", "null"],
          "description": "Hex-encoded Code Directory Hash."
        },
        "executablePath": {
          "type": ["string", "null"],
          "description": "Exact path to the executable."
        },
        "executablePathPrefix": {
          "type": ["string", "null"],
          "description": "Path prefix for executable location."
        }
      }
    }
  }
}
